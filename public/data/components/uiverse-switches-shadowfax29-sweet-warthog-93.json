  position: absolute;\r\n  content: \"\";\r\n  height: 1.4em;\r\n  width: 1.4em;\r\n  border-radius: 20px;\r\n  left: 0.3em;\r\n  bottom: 0.3em;\r\n  transition: .4s;\r\n}\r\n\r\n.__UIV_SCOPE__ .switch input:checked + .slider {\r\n  background-color: #156829;\r\n}\r\n\r\n.__UIV_SCOPE__ .switch input:focus + .slider {\r\n  box-shadow: 0 0 1px #156829;\r\n}\r\n\r\n.__UIV_SCOPE__ .switch input:checked + .slider:before,\r\n.__UIV_SCOPE__ .switch input:checked + .slider .seed {\r\n  transform: translateX(1.5em);\r\n}\r\n\r\n.__UIV_SCOPE__ .switch input:checked + .slider .seed {\r\n  opacity: 0;\r\n}\r\n\r\n.__UIV_SCOPE__ .switch input:checked + .slider .plant {\r\n  animation: zoomIn 0.5s forwards;\r\n}\r\n\r\n@keyframes zoomIn {\r\n  0% {\r\n    transform: scale(0);\r\n    opacity: 0;\r\n  }\r\n\r\n  100% {\r\n    transform: scale(1);\r\n    opacity: 1;\r\n  }\r\n}"}