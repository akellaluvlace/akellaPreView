n.__UIV_SCOPE__ button#space-btn div.star {\r\n  width: 1px;\r\n  height: 1px;\r\n  background-color: white;\r\n  border-radius: 50%;\r\n  animation: blink 2s cubic-bezier(0.15, 0.83, 0.66, 1) infinite;\r\n}\r\n\r\n.__UIV_SCOPE__ button#space-btn div.shooting-star {\r\n  width: 80px;\r\n  height: 1px;\r\n  position: absolute;\r\n  background: linear-gradient(80deg, #ffffffff, #ffffff00);\r\n  border-radius: 50%;\r\n  transform: rotate(-40deg);\r\n  opacity: 0\r\n}\r\n\r\n.__UIV_SCOPE__ button#space-btn div.shooting-star-1 {\r\n  animation: fallingStar1 4s 6s cubic-bezier(0.15, 0.83, 0.66, 1) infinite;\r\n}\r\n\r\n.__UIV_SCOPE__ button#space-btn div.shooting-star-2 {\r\n  animation: fallingStar2 2s 10s cubic-bezier(0.15, 0.83, 0.66, 1) infinite;\r\n}\r\n\r\n.__UIV_SCOPE__ button#space-btn div.shooting-star-3 {\r\n  animation: fallingStar3 8s 20s cubic-bezier(0.15, 0.83, 0.66, 1) infinite;\r\n}\r\n\r\n.__UIV_SCOPE__ button#space-btn div.shooting-star-4 {\r\n  animation: fallingStar4 4s 6s cubic-bezier(0.15, 0.83, 0.66, 1) infinite;\r\n}\r\n\r\n@keyframes blink {\r\n  0% {\r\n    box-shadow: 0 0 10px 0 white;\r\n  }\r\n\r\n  50% {\r\n    box-shadow: 0 0 10px 2px white;\r\n  }\r\n\r\n  100% {\r\n    box-shadow: 0 0 10px 0 white;\r\n  }\r\n}\r\n\r\n@keyframes fallingStar1 {\r\n  0% {\r\n    top: -10px;\r\n    left: 220px;\r\n    opacity: 1;\r\n  }\r\n\r\n  100% {\r\n    top: 200px;\r\n    left: -20px;\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@keyframes fallingStar2 {\r\n  0% {\r\n    top: -10px;\r\n    left: 150px;\r\n    opacity: 1;\r\n  }\r\n\r\n  100% {\r\n    top: 200px;\r\n    left: -90px;\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@keyframes fallingStar3 {\r\n  0% {\r\n    top: -10px;\r\n    left: 80px;\r\n    opacity: 1\r\n  }\r\n\r\n  100% {\r\n    top: 200px;\r\n    left: -160px;\r\n    opacity: 1\r\n  }\r\n}\r\n\r\n@keyframes fallingStar4 {\r\n  0% {\r\n    top: -10px;\r\n    left: 0px;\r\n    opacity: 1;\r\n  }\r\n\r\n  100% {\r\n    top: 200px;\r\n    left: -240px;\r\n    opacity: 1;\r\n  }\r\n}"}